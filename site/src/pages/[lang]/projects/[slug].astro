---
/**
 * Project page. One shell, with modules that appear only when a project has the material for them
 * (owner direction 2026-09-26 kept, 2026-09 design pass extended it):
 * 1. hero: what it is, key facts, and the real product (a capture of its public page) or its logo over brand art;
 * 2. the problem and how the project tackles it;
 * 3. what it does (capabilities);
 * 4. the user flow as an animated diagram, with an ordered list underneath for assistive tech;
 * 5. research and resources: papers, artifacts, open-source code and research directions tied to the project;
 * 6. get involved: the contact channels;
 * 7. related projects.
 * Every module reads from src/data and src/content, so no project page states anything the data does not.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import StageBadge from '@/components/StageBadge.astro';
import Crumbs from '@/components/docs/Crumbs.astro';
import ProductVisual from '@/components/products/ProductVisual.astro';
import ProductCard from '@/components/products/ProductCard.astro';
import FlowDiagram from '@/components/flow/FlowDiagram';
import type { FlowStepData } from '@/components/flow/flow-layout';
import { products, type Product } from '@/data/products';
import { directions, publications, openWork } from '@/data/research';
import { artifactsFor } from '@/lib/artifacts';
import { site } from '@/config/site';
import { localePath, t } from '@/i18n/utils';
import { locales, pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return locales.flatMap((lang) => products.map((product) => ({ params: { lang, slug: product.slug }, props: { product } })));
}
const locale = Astro.params.lang as Locale;
const { product } = Astro.props as { product: Product };
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

const copy = {
  en: {
    siteName: 'Sudaverse',
    openSite: 'Open project site',
    repo: 'View on GitHub',
    involved: 'Get involved',
    facts: 'Project facts',
    langNames: { ar: 'Arabic', en: 'English' } as Record<string, string>,
    problem: 'The problem',
    approach: (n: string) => `How ${n} tackles it`,
    capabilities: 'What it does',
    flowH: 'How it works',
    flowLead: (n: string) => `The path a user takes through ${n}, step by step.`,
    flowLabel: (n: string) => `${n} user flow`,
    resH: 'Research and resources',
    resLead: (n: string) => `The published work, open code and research directions behind ${n}.`,
    kind: { paper: 'Paper', preprint: 'Preprint', report: 'Report', artifact: 'Artifact', code: 'Open source', direction: 'Research direction' },
    readArtifact: 'Read the artifact',
    viewPaper: 'Paper details',
    viewDirection: 'See the direction',
    license: (l: string) => `${l} license`,
    getH: 'Get involved',
    getLead: (n: string) => `Want to use ${n}, pilot it in your organization, or build on it with us? Reach the team on any of these channels.`,
    email: 'Email',
    form: 'Message form',
    whatsapp: 'WhatsApp',
    telegram: 'Telegram',
    signal: 'Signal',
    subject: (n: string) => `About ${n}`,
    relatedH: 'Related projects',
    all: 'All projects',
  },
  ar: {
    siteName: 'سودافيرس',
    openSite: 'افتح موقع المشروع',
    repo: 'عرض على GitHub',
    involved: 'شارك معنا',
    facts: 'معلومات المشروع',
    langNames: { ar: 'العربية', en: 'الإنجليزية' } as Record<string, string>,
    problem: 'المشكلة',
    approach: (n: string) => `كيف يعالجها ${n}`,
    capabilities: 'ما الذي يقدّمه',
    flowH: 'كيف يعمل',
    flowLead: (n: string) => `المسار الذي يسلكه المستخدم في ${n}، خطوة بخطوة.`,
    flowLabel: (n: string) => `مسار المستخدم في ${n}`,
    resH: 'البحث والموارد',
    resLead: (n: string) => `الأعمال المنشورة والشيفرة المفتوحة واتجاهات البحث التي يقوم عليها ${n}.`,
    kind: { paper: 'ورقة بحثية', preprint: 'مسودة بحثية', report: 'تقرير', artifact: 'مقالة تقنية', code: 'مفتوح المصدر', direction: 'اتجاه بحثي' },
    readArtifact: 'اقرأ المقالة',
    viewPaper: 'تفاصيل الورقة',
    viewDirection: 'اطّلع على الاتجاه',
    license: (l: string) => `رخصة ${l}`,
    getH: 'شارك معنا',
    getLead: (n: string) => `تريد استخدام ${n}، أو تجربته في مؤسستك، أو البناء عليه معنا؟ تواصل مع الفريق عبر أي من هذه القنوات.`,
    email: 'البريد الإلكتروني',
    form: 'نموذج الرسائل',
    whatsapp: 'واتساب',
    telegram: 'تيليجرام',
    signal: 'سيجنال',
    subject: (n: string) => `بخصوص ${n}`,
    relatedH: 'مشاريع ذات صلة',
    all: 'كل المشاريع',
  },
}[locale];

const name = product.name;
const tagline = L(product.tagline);
const summary = L(product.summary);
const nm = `<bdi translate="no">${name}</bdi>`;

function metaDescription(text: string) {
  if (text.length <= 160) return text;
  let out = '';
  for (const s of text.match(/[^.]+\.?/g) ?? [text]) {
    if ((out + s).trim().length > 160) break;
    out += s;
  }
  return (out || text.slice(0, 157) + '...').trim();
}
const fullTitle = `${name}: ${tagline.replace(/\.$/, '')} | ${copy.siteName}`;
const title = fullTitle.length <= 80 ? fullTitle : `${name}: ${t(locale, `category.${product.category}` as const)} | ${copy.siteName}`;
const description = metaDescription(summary);

const projectsHref = localePath(locale, 'projects');
const formHref = `${localePath(locale, 'contact')}?topic=product&product=${product.slug}`;
const steps: FlowStepData[] = (product.flow ?? []).map((s) => ({ id: s.id, title: s.title, desc: s.desc }));

const externals = [
  product.url && { href: product.url, label: copy.openSite },
  product.docs && { href: product.docs, label: copy.repo },
].filter(Boolean) as { href: string; label: string }[];

// Hero facts: only what the data holds.
const facts = [
  { k: t(locale, 'misc.category'), v: t(locale, `category.${product.category}` as const) },
  product.languages?.length && { k: t(locale, 'misc.languages'), v: product.languages.map((l) => copy.langNames[l] ?? l).join(locale === 'ar' ? '، ' : ', ') },
  product.audience && { k: t(locale, 'misc.audience'), v: L(product.audience) },
].filter(Boolean) as { k: string; v: string }[];

// Research and resources tied to this project.
const papers = publications.filter((p) => p.projects?.includes(product.slug));
const arts = (await artifactsFor(locale)).filter(({ entry }) => entry.data.projects.includes(product.slug)).slice(0, 3);
const code = openWork.filter((w) => w.href === product.docs);
const related = directions.filter((d) => d.projects.includes(product.slug));
const fmtDate = (d: Date) => new Intl.DateTimeFormat(locale === 'ar' ? 'ar' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
type Res = { kind: string; title: string; meta: string[]; href: string; cta: string; external?: boolean; lang?: string };
const resources: Res[] = [
  ...papers.map((p) => ({
    kind: copy.kind[p.kind],
    title: p.title,
    meta: [p.venue, String(p.year)],
    href: `${localePath(locale, 'research/papers')}#${p.id}`,
    cta: copy.viewPaper,
    lang: 'en',
  })),
  ...arts.map(({ entry }) => ({
    kind: copy.kind.artifact,
    title: entry.data.title,
    meta: [fmtDate(entry.data.date)],
    href: localePath(locale, `research/artifacts/${entry.data.permalink}`),
    cta: copy.readArtifact,
    lang: entry.data.lang,
  })),
  ...code.map((w) => ({
    kind: copy.kind.code,
    title: w.name,
    meta: [L(w.kind), w.license ? copy.license(w.license) : ''].filter(Boolean),
    href: w.href,
    cta: copy.repo,
    external: true,
  })),
  ...related.map((d) => ({
    kind: copy.kind.direction,
    title: L(d.title),
    meta: [],
    href: `${localePath(locale, 'research/directions')}#${d.id}`,
    cta: copy.viewDirection,
  })),
];

// Related projects: the same family first, then projects that share a research direction.
const sharesDirection = (p: Product) => directions.some((d) => d.projects.includes(p.slug) && d.projects.includes(product.slug));
const others = products.filter((p) => p.slug !== product.slug);
const relatedProducts = [
  ...others.filter((p) => p.category === product.category),
  ...others.filter((p) => p.category !== product.category && sharesDirection(p)),
  ...others.filter((p) => p.category !== product.category && !sharesDirection(p)),
].slice(0, 3);

const c = site.contact;
const channels = [
  { icon: 'mail', label: copy.email, detail: c.email, href: `mailto:${c.email}?subject=${encodeURIComponent(copy.subject(name))}`, ltr: true },
  { icon: 'edit', label: copy.form, detail: '', href: formHref },
  c.whatsapp && { icon: 'whatsapp', label: copy.whatsapp, detail: '', href: `https://wa.me/${c.whatsapp}?text=${encodeURIComponent(`${t(locale, 'wa.prefill')}${name}`)}`, external: true },
  c.telegram && { icon: 'telegram', label: copy.telegram, detail: `@${c.telegram}`, href: `https://t.me/${c.telegram}`, external: true, ltr: true },
  c.signal && { icon: 'signal', label: copy.signal, detail: '', href: c.signal, external: true },
  { icon: 'linkedin', label: 'LinkedIn', detail: '', href: site.social.linkedin, external: true },
  { icon: 'github', label: 'GitHub', detail: '', href: site.social.github, external: true },
].filter(Boolean) as { icon: 'mail' | 'edit' | 'whatsapp' | 'telegram' | 'signal' | 'linkedin' | 'github'; label: string; detail: string; href: string; external?: boolean; ltr?: boolean }[];

const abs = (path: string) => `${site.origin}${path}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: abs(localePath(locale)) },
      { '@type': 'ListItem', position: 2, name: t(locale, 'nav.projects'), item: abs(projectsHref) },
      { '@type': 'ListItem', position: 3, name, item: abs(localePath(locale, `projects/${product.slug}`)) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name,
    description: summary,
    applicationCategory: product.slug === 'sudatutor' ? 'EducationalApplication' : 'BusinessApplication',
    ...(product.languages?.length ? { inLanguage: product.languages } : {}),
    ...(product.url ? { url: product.url } : {}),
    publisher: { '@type': 'Organization', name: site.name, url: `${site.origin}/` },
  },
];
---

<Base title={title} description={description} nav="projects" jsonLd={jsonLd}>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="container">
      <Crumbs locale={locale} items={[{ label: t(locale, 'nav.projects'), href: projectsHref }, { label: name }]} />
      <div class="hero__grid">
        <div class="hero__text">
          <div class="hero__head">
            <h1 id="hero-h" translate="no">{name}</h1>
            <StageBadge stage={product.stage} locale={locale} />
          </div>
          <p class="hero__tag">{tagline}</p>
          <p class="hero__sum">{summary}</p>
          <div class="cluster hero__cta">
            <Button href="#involved" variant="primary" arrow>{copy.involved}</Button>
            {
              externals.map((e) => (
                <a class="ext" href={e.href} target="_blank" rel="noopener noreferrer">
                  {e.label}
                  <Icon name="external" size={16} />
                  <span class="sr-only"> ({t(locale, 'a11y.external')})</span>
                </a>
              ))
            }
          </div>
          <dl class="facts" aria-label={copy.facts}>
            {
              facts.map((f) => (
                <div class="facts__row">
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="hero__visual">
          <ProductVisual product={product} locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. The problem, and how the project tackles it -->
  {
    (product.problem || product.approach) && (
      <section class="section section--tight pa" aria-labelledby={product.problem ? 'problem-h' : 'approach-h'}>
        <div class="container pa__grid">
          {product.problem && (
            <div class="pa__col" data-reveal>
              <h2 id="problem-h" class="pa__k">{copy.problem}</h2>
              <p class="pa__lead">{L(product.problem)}</p>
            </div>
          )}
          {product.approach && (
            <div class="pa__col pa__col--approach" data-reveal>
              <h2 id="approach-h" class="pa__k" set:html={copy.approach(nm)} />
              <p class="pa__lead">{L(product.approach)}</p>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 3. What it does -->
  {
    product.capabilities && product.capabilities.length > 0 && (
      <section class="section section--tight caps" aria-labelledby="caps-h">
        <div class="container caps__grid">
          <h2 id="caps-h" class="caps__h" data-reveal>
            {copy.capabilities}
          </h2>
          <ul role="list" class="caps__list" data-reveal>
            {product.capabilities.map((cap) => (
              <li>
                <span class="caps__icon" aria-hidden="true">
                  <Icon name="check" size={18} />
                </span>
                <span>{L(cap)}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 4. The user flow -->
  {
    steps.length >= 3 && (
      <section class="section section--alt flow" aria-labelledby="flow-h">
        <div class="container">
          <div class="flow__head" data-reveal>
            <h2 id="flow-h">{copy.flowH}</h2>
            <p class="t-lead" set:html={copy.flowLead(nm)} />
          </div>
          <FlowDiagram client:visible locale={locale} steps={steps} label={copy.flowLabel(name)} names={[name]} />
        </div>
      </section>
    )
  }

  <!-- 5. Research and resources -->
  {
    resources.length > 0 && (
      <section class="section section--tight res" aria-labelledby="res-h">
        <div class="container res__grid">
          <div class="res__head" data-reveal>
            <h2 id="res-h">{copy.resH}</h2>
            <p class="t-muted" set:html={copy.resLead(nm)} />
          </div>
          <ul role="list" class="res__list" data-reveal>
            {resources.map((r) => (
              <li>
                <a class="res__row" href={r.href} {...(r.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  <span class="res__kind">{r.kind}</span>
                  <span class="res__main">
                    <span class="res__title" lang={r.lang && r.lang !== locale ? r.lang : undefined} dir={r.lang && r.lang !== locale ? 'auto' : undefined}>
                      {r.title}
                    </span>
                    {r.meta.length > 0 && <span class="res__meta">{r.meta.join(' · ')}</span>}
                  </span>
                  <span class="res__cta">
                    {r.cta}
                    <Icon name={r.external ? 'external' : 'arrow'} size={16} directional={!r.external} />
                    {r.external && <span class="sr-only"> ({t(locale, 'a11y.external')})</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 6. Get involved -->
  <section class="section section--tight involved" id="involved" aria-labelledby="inv-h">
    <div class="container involved__grid">
      <div class="involved__text">
        <h2 id="inv-h">{copy.getH}</h2>
        <p class="t-lead" set:html={copy.getLead(nm)} />
      </div>
      <ul role="list" class="channels">
        {
          channels.map((ch) => (
            <li>
              <a class="ch" href={ch.href} {...(ch.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="ch__icon"><Icon name={ch.icon} size={20} /></span>
                <span class="ch__label">{ch.label}</span>
                {ch.detail && <span class="ch__detail" dir={ch.ltr ? 'ltr' : undefined}>{ch.detail}</span>}
                <Icon name={ch.external ? 'external' : 'arrow'} size={16} directional={!ch.external} class="ch__go" />
                {ch.external && <span class="sr-only"> ({t(locale, 'a11y.external')})</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Related projects -->
  <section class="section section--alt related" aria-labelledby="rel-h">
    <div class="container">
      <div class="related__head">
        <h2 id="rel-h">{copy.relatedH}</h2>
        <a class="textlink" href={projectsHref}>
          {copy.all}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <ul role="list" class="related__list">
        {
          relatedProducts.map((p) => (
            <li>
              <ProductCard product={p} locale={locale} showCategory compact />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .ext {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.75rem;
    font-weight: 620;
    text-decoration: none;
  }
  .ext:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* ---- 1. Hero ---- */
  .hero {
    padding-block: var(--s-4) var(--section-y-tight);
    overflow-x: clip;
  }
  .hero__grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
    margin-block-start: var(--s-5);
  }
  .hero__text {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    min-inline-size: 0;
  }
  .hero__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
  }
  .hero__tag {
    font-size: var(--fs-500);
    font-weight: 620;
    line-height: var(--lh-snug);
    color: var(--color-text);
    max-inline-size: 30ch;
  }
  .hero__sum {
    color: var(--color-text-muted);
    max-inline-size: 58ch;
  }
  .hero__cta {
    margin-block-start: var(--s-2);
  }
  .hero__visual {
    min-inline-size: 0;
  }

  /* Key facts: a ruled definition list, label over value. */
  .facts {
    display: grid;
    inline-size: 100%;
    margin-block-start: var(--s-4);
    border-block-start: 1px solid var(--color-border-strong);
  }
  .facts__row {
    display: grid;
    grid-template-columns: minmax(7rem, 9rem) minmax(0, 1fr);
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-block-end: 1px solid var(--color-border);
    font-size: var(--fs-200);
  }
  .facts dt {
    font-size: var(--fs-100);
    font-weight: 650;
    letter-spacing: var(--tracking-meta);
    color: var(--color-text-meta);
    padding-block-start: 0.15em;
  }
  .facts dd {
    margin: 0;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--s-8);
    }
  }

  /* ---- 2. Problem and approach ---- */
  .pa__grid {
    display: grid;
    gap: var(--s-7);
  }
  .pa__col {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--color-border-strong);
  }
  .pa__col--approach {
    border-block-start-color: var(--nile-700);
  }
  .pa__k {
    font-size: var(--fs-200);
    font-weight: 650;
    line-height: var(--lh-snug);
    letter-spacing: 0;
    color: var(--color-text-meta);
  }
  .pa__col--approach .pa__k {
    color: var(--nile-700);
  }
  .pa__lead {
    font-size: var(--fs-400);
    line-height: 1.5;
    color: var(--color-text);
  }
  @media (min-width: 48rem) {
    .pa__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-8);
    }
  }

  /* ---- 3. What it does ---- */
  .caps {
    padding-block-start: 0;
  }
  .caps__grid {
    display: grid;
    gap: var(--s-5);
  }
  .caps__h {
    font-size: var(--fs-500);
  }
  .caps__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .caps__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--color-border);
  }
  .caps__icon {
    display: grid;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 50%;
    background: var(--sage-100);
    color: var(--sage-800);
  }
  @media (min-width: 48rem) {
    .caps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-7);
    }
  }
  @media (min-width: 64rem) {
    .caps__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: var(--s-8);
    }
  }

  /* ---- 4. User flow ---- */
  .flow__head {
    display: grid;
    gap: var(--s-3);
    margin-block-end: var(--s-6);
  }

  /* ---- 5. Research and resources ---- */
  .res__grid {
    display: grid;
    gap: var(--s-5);
  }
  .res__head {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .res__head h2 {
    font-size: var(--fs-500);
  }
  .res__list {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .res__row {
    display: grid;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
    padding-inline: var(--s-1);
    border-block-end: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }
  .res__row:hover {
    background: var(--paper-2);
  }
  .res__kind {
    font-size: var(--fs-100);
    font-weight: 650;
    letter-spacing: var(--tracking-meta);
    color: var(--color-text-meta);
    padding-block-start: 0.2em;
  }
