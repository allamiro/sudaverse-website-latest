---
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/products/ProductCard.astro';
import CtaBand from '@/components/products/CtaBand.astro';
import { categoryOrder, productsByCategory, type CategoryId } from '@/data/products';
import { site } from '@/config/site';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;

const copy = {
  en: {
    title: 'Projects: Arabic-first AI and open tools | Sudaverse',
    description:
      'AI projects and open tools built around Arabic language, local context and domain workflows, from education and agriculture to security and geospatial monitoring.',
    h1: 'Projects',
    lead: 'Sudaverse builds AI projects and open tools around Arabic language, local context and the workflows of specific domains.',
    count: (n: number, f: number) => `${n} projects in ${f} families.`,
    jump: 'Project families',
    cats: {
      'ai-products': 'AI products for education and agriculture, built to work in Arabic.',
      'data-intelligence': 'Geospatial platforms for situational awareness and flood early warning.',
      'secure-ai': 'Security systems that apply AI to defending networks.',
      'language-research': 'Open tooling for Arabic language models and their training data.',
    } as Record<CategoryId, string>,
    cta: {
      h2: 'Start with a briefing.',
      body: 'Ask about a project, an integration or a wider engagement. You will talk with our engineering team.',
    },
  },
  ar: {
    title: 'المشاريع: ذكاء اصطناعي عربي أولاً وأدوات مفتوحة | سودافيرس',
    description:
      'مشاريع ذكاء اصطناعي وأدوات مفتوحة مبنية حول اللغة العربية والسياق المحلي وسير العمل في المجالات المتخصصة، من التعليم والزراعة إلى الأمن والمراقبة الجغرافية.',
    h1: 'المشاريع',
    lead: 'تبني سودافيرس مشاريع ذكاء اصطناعي وأدوات مفتوحة حول اللغة العربية والسياق المحلي وسير العمل في مجالات متخصصة.',
    // Arabic counted nouns: 3 to 10 take the genitive plural, 11 and up the accusative singular.
    count: (n: number, f: number) => `${n} ${n <= 10 ? 'مشاريع' : 'مشروعًا'} في ${f} ${f <= 10 ? 'مجالات' : 'مجالًا'}.`,
    jump: 'مجالات المشاريع',
    cats: {
      'ai-products': 'منتجات ذكاء اصطناعي للتعليم والزراعة، مبنية لتعمل بالعربية.',
      'data-intelligence': 'منصات جغرافية مكانية للوعي بالموقف والإنذار المبكر من الفيضانات.',
      'secure-ai': 'أنظمة أمنية تطبّق الذكاء الاصطناعي على حماية الشبكات.',
      'language-research': 'أدوات مفتوحة للنماذج اللغوية العربية وبيانات تدريبها.',
    } as Record<CategoryId, string>,
    cta: {
      h2: 'ابدأ بجلسة تعريفية.',
      body: 'اسأل عن مشروع أو تكامل أو تعاون أوسع، وستتحدث مع فريقنا الهندسي.',
    },
  },
}[locale];

const groups = categoryOrder
  .map((id) => ({ id, items: productsByCategory(id) }))
  .filter((g) => g.items.length > 0);
const total = groups.reduce((n, g) => n + g.items.length, 0);

const abs = (path: string) => `${site.origin}${path}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: abs(localePath(locale)) },
      { '@type': 'ListItem', position: 2, name: copy.h1, item: abs(localePath(locale, 'projects')) },
    ],
  },
];
---

<Base title={copy.title} description={copy.description} nav="projects" jsonLd={jsonLd}>
  <section class="head" aria-labelledby="products-h">
    <div class="container head__grid">
      <h1 id="products-h">{copy.h1}</h1>
      <div class="head__text">
        <p class="t-lead">{copy.lead}</p>
        <p class="t-small t-muted">{copy.count(total, groups.length)}</p>
      </div>
    </div>
    <nav class="container jump" aria-label={copy.jump}>
      <ul role="list" class="jump__list">
        {
          groups.map((g) => (
            <li>
              <a class="jump__chip" href={`#cat-${g.id}`}>
                {t(locale, `category.${g.id}` as const)}
                <span class="jump__n" aria-hidden="true">{g.items.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  {
    groups.map((g, i) => (
      <section class:list={['cat', { 'cat--alt': i % 2 === 0 }]} aria-labelledby={`cat-${g.id}`}>
        <div class="container cat__grid">
          <div class="cat__head" data-reveal>
            <h2 id={`cat-${g.id}`}>{t(locale, `category.${g.id}` as const)}</h2>
            <p class="cat__desc">{copy.cats[g.id]}</p>
          </div>
          <ul role="list" class="cat__list" data-reveal>
            {g.items.map((p) => (
              <li>
                <ProductCard product={p} locale={locale} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <CtaBand
    id="products-cta-h"
    heading={copy.cta.h2}
    body={copy.cta.body}
    primary={{ href: `${localePath(locale, 'contact')}?topic=product`, label: t(locale, 'cta.talk') }}
    secondary={{ href: `${localePath(locale)}#services`, label: t(locale, 'nav.services') }}
    seed={12}
  />
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 1.25rem + 5vw, 5.5rem) var(--section-y-tight);
  }
  .head__grid {
    display: grid;
    gap: var(--s-5);
    align-items: end;
  }
  .head__text {
    display: grid;
    gap: var(--s-3);
  }
  @media (min-width: 64rem) {
    .head__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--s-9);
    }
  }

  /* Family jump links: every family is one tap away, no filtering state to lose. */
  .jump {
    margin-block-start: var(--s-7);
  }
  .jump__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }
  .jump__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: 2.75rem;
    padding-inline: var(--s-4) var(--s-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--fs-200);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }
  .jump__chip:hover {
    background: var(--color-surface);
    border-color: var(--nile-700);
  }
  .jump__n {
    display: grid;
    place-items: center;
    min-inline-size: 1.5rem;
    block-size: 1.5rem;
    padding-inline: 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--nile-100);
    color: var(--nile-800);
    font-size: var(--fs-100);
    font-variant-numeric: tabular-nums;
  }

  .cat {
    padding-block: var(--section-y-tight);
    scroll-margin-block-start: var(--header-h);
  }
  .cat--alt {
    background: var(--color-bg-alt);
  }
  .cat__grid {
    display: grid;
    gap: var(--s-6);
    align-items: start;
  }
  .cat__head {
    display: grid;
    gap: var(--s-3);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--color-border-strong);
  }
  .cat__head h2 {
    font-size: var(--fs-500);
    line-height: var(--lh-heading);
    max-inline-size: 16ch;
  }
  .cat__desc {
    color: var(--color-text-muted);
    max-inline-size: 34ch;
  }
  .cat__list {
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
  }
  @media (min-width: 40rem) {
    .cat__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .cat__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      column-gap: var(--s-8);
    }
    .cat__head {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--s-6));
    }
    .cat__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
